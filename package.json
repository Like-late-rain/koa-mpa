{
  "name": "koa-mpa",
  "version": "1.0.0",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "dotenv -e .env.development -- ts-node-dev --respawn --transpile-only app.ts",
    "build": "tsc && cp -r generated dist/ && cp -r views dist/ && cp -r assets dist/",
    "lint": "biome check --write .",
    "db:generate": "dotenv -e .env.development -- prisma generate",
    "db:migrate": "dotenv -e .env.development -- prisma migrate dev",
    "db:studio": "dotenv -e .env.development -- prisma studio",
    "db:push": "dotenv -e .env.development -- prisma db push",
    "deploy:prod": "yarn build && prisma generate && sam build && sam deploy --force-upload --no-fail-on-empty-changeset",
    "deploy:prod:guided": "yarn build && prisma generate && sam build && sam deploy --guided",
    "deploy:migrate": "aws lambda invoke --function-name $(aws lambda list-functions --region ap-northeast-1 --query \"Functions[?contains(FunctionName, 'Migrate')].FunctionName\" --output text) --region ap-northeast-1 /tmp/migrate-response.json && cat /tmp/migrate-response.json",
    "deploy:logs": "aws logs tail /aws/lambda/koa-mpa-stack-KoaFunction-NEbrtEojzjgJ --region ap-northeast-1 --since 10m --format short"
  },
  "keywords": [],
  "author": "东方美人",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@koa/ejs": "^5.1.0",
    "@prisma/adapter-mariadb": "^7.1.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "awilix": "^12.0.5",
    "awilix-koa": "^11.1.0",
    "dotenv": "^17.2.3",
    "koa": "^3.1.1",
    "koa-bodyparser": "^4.4.1",
    "koa-static": "^5.0.0",
    "koa2-connect-history-api-fallback": "^0.1.3",
    "log4js": "^6.9.1",
    "mariadb": "^3.4.5",
    "module-alias": "^2.2.3",
    "pg": "^8.16.3",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/koa": "^3.0.1",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-static": "^4.0.4",
    "@types/koa__ejs": "^5.1.1",
    "@types/lodash": "^4.17.21",
    "@types/module-alias": "^2.0.4",
    "@types/pg": "^8.16.0",
    "dotenv-cli": "^11.0.0",
    "lodash": "^4.17.21",
    "prisma": "^7.2.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@1.22.22"
}
