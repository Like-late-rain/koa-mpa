# 应用配置
NODE_ENV=development
PORT=8081

# 数据库配置 - MySQL
# 格式: mysql://用户名:密码@主机地址:端口/数据库名
# 本地开发示例:
DATABASE_URL="mysql://root:password@localhost:3306/koa_mpa"

# 阿里云 RDS/ECS MySQL 示例:
# DATABASE_URL="mysql://username:password@rm-xxxxx.mysql.rds.aliyuncs.com:3306/database_name"

# Redis 配置（如需要）
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# JWT 配置（如需要）
# JWT_SECRET=your-secret-key
# JWT_EXPIRES_IN=7d

# 日志配置
LOG_LEVEL=info

# 其他配置
# API_BASE_URL=http://localhost:8081
