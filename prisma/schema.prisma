// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 用户表 - 支持手动创建和 GitHub OAuth 登录
model User {
  id        String   @id @default(cuid())
  githubId  String?  @unique              // GitHub 用户 ID（GitHub 登录时自动填充）
  walletAddress String?  @unique  // 钱包地址（钱包登录时使用）
  username  String                        // 用户名
  email     String?  @unique              // 邮箱（可选）
  avatarUrl String?                       // 头像 URL
  name      String?                       // 显示名称

  // 关联
  formData  FormData[]
  sessions  Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// 表单数据表 - 用于存储用户提交的表单
model FormData {
  id        String   @id @default(cuid())
  field1    String                        // 表单字段 1
  field2    String                        // 表单字段 2

  // 关联到用户（可选）
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("form_data")
  @@index([userId])
}

// 会话表 - 用于 GitHub OAuth 会话管理
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique              // 会话 token
  expiresAt DateTime                      // 过期时间

  createdAt DateTime @default(now())

  @@map("sessions")
  @@index([userId])
  @@index([token])
}
