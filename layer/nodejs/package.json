{
  "name": "koa-mpa",
  "version": "1.0.0",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only app.ts",
    "build": "tsc",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "pm2:start": "pm2 start ecosystem.config.js --only koa-mpa --env production",
    "pm2:start:dev": "pm2 start ecosystem.config.js --only koa-mpa-dev",
    "pm2:stop": "pm2 stop koa-mpa",
    "pm2:stop:dev": "pm2 stop koa-mpa-dev",
    "pm2:stop:all": "pm2 stop all",
    "pm2:restart": "pm2 restart koa-mpa",
    "pm2:restart:dev": "pm2 restart koa-mpa-dev",
    "pm2:reload": "pm2 reload koa-mpa",
    "pm2:delete": "pm2 delete koa-mpa",
    "pm2:delete:dev": "pm2 delete koa-mpa-dev",
    "pm2:delete:all": "pm2 delete all",
    "pm2:logs": "pm2 logs",
    "pm2:logs:prod": "pm2 logs koa-mpa",
    "pm2:logs:dev": "pm2 logs koa-mpa-dev",
    "pm2:monit": "pm2 monit",
    "pm2:list": "pm2 list",
    "pm2:save": "pm2 save",
    "pm2:flush": "pm2 flush",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push --accept-data-loss",
    "prisma:pull": "prisma db pull",
    "prisma:seed": "prisma db seed"
  },
  "keywords": [],
  "author": "东方美人",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/ejs": "^5.1.0",
    "@prisma/adapter-mariadb": "^7.1.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "awilix": "^12.0.5",
    "awilix-koa": "^11.1.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.16.0",
    "koa": "^3.1.1",
    "koa-bodyparser": "^4.4.1",
    "koa-static": "^5.0.0",
    "koa2-connect-history-api-fallback": "^0.1.3",
    "log4js": "^6.9.1",
    "mariadb": "^3.4.5",
    "module-alias": "^2.2.3",
    "pg": "^8.16.3",
    "serverless-http": "^4.0.0"
  },
